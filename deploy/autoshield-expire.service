[Unit]
Description=Expire AutoShield-managed UFW blocks
After=ufw.service

[Service]
Type=oneshot
User=autoshield
Group=autoshield
ExecStart=/usr/bin/python3 /opt/autoshield/enforcer.py --expire --apply --state-file /var/lib/autoshield/blocks.sqlite3 --audit-file /var/log/autoshield/audit.jsonl
StateDirectory=autoshield
LogsDirectory=autoshield
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/etc/ufw /run/lock -/run/xtables.lock
LockPersonality=true
RestrictSUIDSGID=true
RestrictRealtime=true
CapabilityBoundingSet=CAP_NET_ADMIN
